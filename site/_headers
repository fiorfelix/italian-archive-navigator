# Security headers for every page (Cloudflare Pages _headers format).
# The site has no scripts of its own and no inline styles. The only script is Cloudflare Web
# Analytics, which Cloudflare injects and which reports to cloudflareinsights.com, and
# Cloudflare's e-mail address decoder, served from this site under /cdn-cgi/ ('self').
/*
  Strict-Transport-Security: max-age=31536000
  Content-Security-Policy: default-src 'none'; script-src 'self' https://static.cloudflareinsights.com; connect-src https://cloudflareinsights.com; style-src 'self'; img-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=()
  Cross-Origin-Opener-Policy: same-origin
